{% load static %}
<!doctype html><html lang="en" data-theme="dark"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#000000"><meta name="description" content="FILM SALOON &#8212; Movies &#8226; Reviews &#8226; More">
<link rel="manifest" href="{% url 'manifest' %}"><link rel="icon" href="{% static 'icons/icon-192.png' %}"><link rel="apple-touch-icon" href="{% static 'icons/icon-192.png' %}">
<link rel="stylesheet" href="{% static 'css/site.css' %}"><script defer src="{% static 'js/app.js' %}"></script><script defer src="{% static 'js/pwa.js' %}"></script>
<title>{% block title %}FILM SALOON{% endblock %}</title></head><body>
<header class="site-header"><a class="brand" href="{% url 'home' %}"><img src="{% static 'images/film-saloon-logo.jpg' %}" alt="FILM SALOON"><span>FILM <b>SALOON</b></span></a>
<nav class="main-nav"><a href="{% url 'home' %}">Home</a><a href="{% url 'genres' %}">Genres</a><a href="{% url 'clips' %}">Clips</a><a href="{% url 'actors' %}">Actors</a></nav>
<div class="header-tools"><form class="search-box" action="{% url 'search' %}"><input name="q" value="{{ request.GET.q|default:'' }}" placeholder="Search movies..."><button>&#8981;</button></form>
<button id="themeToggle" class="tool-button" type="button">&#9788;</button><button id="installBtn" class="install-button" type="button" hidden>&#8681; Install App</button><button id="menuButton" class="menu-button" type="button">&#9776;</button></div></header>
<div id="mobileMenu" class="mobile-menu"><a href="{% url 'home' %}">Home</a><a href="{% url 'genres' %}">Genres</a><a href="{% url 'clips' %}">Best Movie Clips</a><a href="{% url 'actors' %}">Actors Profile</a><button id="mobileInstallBtn" type="button" hidden>&#8681; Install FILM SALOON</button></div>
<main class="page-shell">{% if messages %}<div class="toast-stack">{% for message in messages %}<div class="toast">{{ message }}</div>{% endfor %}</div>{% endif %}{% block content %}{% endblock %}</main>
<footer class="site-footer"><div><img src="{% static 'images/film-saloon-logo.jpg' %}" alt=""><div><strong>FILM SALOON</strong><span>Movies &#8212; Reviews &#8226; More</span></div></div><div class="footer-links"><a href="{% url 'genres' %}">Genres</a><a href="{% url 'actors' %}">Actors</a><a href="{% url 'clips' %}">Clips</a><a href="{% url 'search' %}">Search</a></div></footer>
<nav class="mobile-bottom"><a href="{% url 'home' %}"><span>&#8962;</span>Home</a><a href="{% url 'genres' %}"><span>&#9672;</span>Genres</a><a href="{% url 'search' %}"><span>&#8981;</span>Search</a><a href="{% url 'clips' %}"><span>&#9654;</span>Clips</a><a href="{% url 'actors' %}"><span>&#9817;</span>Actors</a></nav>
</body></html>



