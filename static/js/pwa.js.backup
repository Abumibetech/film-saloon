(()=>{"use strict";let deferredPrompt=null;const bs=[document.getElementById("installBtn"),document.getElementById("mobileInstallBtn")].filter(Boolean),standalone=()=>matchMedia("(display-mode: standalone)").matches||navigator.standalone===true,isIOS=/iphone|ipad|ipod/i.test(navigator.userAgent)&&!window.MSStream;const show=()=>{if(!standalone())bs.forEach(b=>b.hidden=false)},hide=()=>bs.forEach(b=>b.hidden=true);async function install(){if(standalone()){hide();return}if(deferredPrompt){deferredPrompt.prompt();try{const c=await deferredPrompt.userChoice;if(c&&c.outcome==="accepted")hide()}catch(e){console.warn(e)}deferredPrompt=null;return}if(isIOS)alert("To install FILM SALOON on iPhone or iPad, tap Share in Safari and choose “Add to Home Screen”.");else alert("Your browser has not supplied the automatic install prompt yet. Open the browser menu and choose “Install app” or “Add to Home screen”.")}bs.forEach(b=>b.onclick=install);addEventListener("beforeinstallprompt",e=>{e.preventDefault();deferredPrompt=e;show()});addEventListener("appinstalled",()=>{deferredPrompt=null;hide()});if(!standalone())setTimeout(show,700);if("serviceWorker"in navigator)addEventListener("load",()=>navigator.serviceWorker.register("/service-worker.js",{scope:"/"}).then(r=>console.log("PWA ready",r.scope)).catch(console.error));})();