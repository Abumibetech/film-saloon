(()=>{const r=document.documentElement,s=localStorage.getItem("film_saloon_theme");if(s)r.dataset.theme=s;const t=document.getElementById("themeToggle");if(t)t.onclick=()=>{const n=r.dataset.theme==="light"?"dark":"light";r.dataset.theme=n;localStorage.setItem("film_saloon_theme",n)};const b=document.getElementById("menuButton"),m=document.getElementById("mobileMenu");if(b&&m)b.onclick=()=>m.classList.toggle("open");})();